{
  "name": "Minecraft Forge 1.20.1 & MCSManager",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "MCSManager Web Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash ./setup.sh",
  "postStartCommand": "bash ./start-all.sh"
}
